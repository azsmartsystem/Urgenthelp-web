# Urgent Help — environment variables
# Copy to .env.local for development. Never commit real values.

# ============================================================
# REQUIRED — the app will not build/run without these
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only — admin routes, webhooks, background workers. NEVER expose to the browser.
ADMIN_SESSION_SECRET=                 # any long random string — signs the admin session cookie (lib/auth/admin.ts). Generate with: openssl rand -hex 32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# OPTIONAL — every one of these has a real, working fallback.
# The app is fully functional with all of them unset.
# ============================================================

# --- Payments (spec §15) ---
# Unset: booking/payment flow works up to "Pay now", which returns a
# typed PAYMENT_PROVIDER_UNAVAILABLE error the UI surfaces cleanly
# (see components/BookingActions.tsx). Withdrawals are still recorded,
# marked for manual processing (see app/api/wallet/me/withdrawals/route.ts).
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- AI services (spec §9) ---
# Unset: lib/ai/matching.ts and lib/ai/pricing.ts use the documented
# deterministic fallback (distance/rating/trust-weighted scoring; category
# base-price ranges) — booking creation and matching work end-to-end.
AI_MATCHING_ENDPOINT=
AI_PRICING_ENDPOINT=
AI_SERVICE_API_KEY=

# --- Maps / Location ---
# Unset: distance/ETA are computed with a haversine straight-line
# calculation (lib/location/distance.ts) instead of real road routing.
MAPS_PROVIDER_API_KEY=

# --- Redis / Upstash (live helper location — spec §21) ---
# Unset: lib/redis/client.ts no-ops every call. Live tracking shows an
# honest "location unavailable" state (components/TrackingMap.tsx)
# instead of a stale or fake position. Availability status still works
# (it's read from Postgres, not Redis, in this build).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Notifications (spec §18) ---
# Unset: in-app notifications (the bell icon, /notifications) always work
# — they're written straight to Postgres. SMS/email delivery is skipped
# and the notification row is marked `failed` for that channel only.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
SMS_PROVIDER_ENDPOINT=
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_ENDPOINT=
